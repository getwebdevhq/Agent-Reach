{
  "name": "agent-reach-leads",
  "version": "1.0.0",
  "description": "Lead Intelligence & Outreach Platform for 150 Verified Instagram Businesses without Websites (Sydney Dog Groomers & UK Tree Surgeons)",
  "scripts": {
    "build:web": "cd web && npm run build",
    "build": "npm run build:web",
    "dev:web": "cd web && npm run dev",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:dry": "npm run build:web && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.161.0"
  },
  "keywords": [
    "cloudflare-workers",
    "nextjs",
    "tailwindcss",
    "lead-generation",
    "instagram-leads",
    "sydney-dog-groomers",
    "uk-tree-surgeons"
  ],
